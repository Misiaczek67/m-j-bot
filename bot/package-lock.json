const {
    Client,
    GatewayIntentBits,
    REST,
    Routes,
    SlashCommandBuilder,
    ModalBuilder,
    TextInputBuilder,
    TextInputStyle,
    ActionRowBuilder,
    ButtonBuilder,
    ButtonStyle,
    EmbedBuilder,
    ChannelType,
    PermissionFlagsBits
} = require("discord.js");

require("dotenv").config();


const client = new Client({

    intents:[
        GatewayIntentBits.Guilds
    ]

});





const commands = [

    new SlashCommandBuilder()
    .setName("ticket")
    .setDescription("Panel ticketów LSC"),


    new SlashCommandBuilder()
    .setName("urlop")
    .setDescription("Podanie o urlop LSC"),


    new SlashCommandBuilder()
    .setName("ogloszenie")
    .setDescription("Ogłoszenie LSC")

].map(x=>x.toJSON());






client.once("ready", async()=>{


console.log(`✅ Bot online: ${client.user.tag}`);



const rest = new REST({version:"10"})
.setToken(process.env.TOKEN);



await rest.put(

Routes.applicationCommands(client.user.id),

{
body:commands
}

);



console.log("✅ Komendy załadowane");


});







client.on("interactionCreate", async interaction => {



if(interaction.isChatInputCommand()){





// ======================
// 🎫 PANEL TICKETÓW
// ======================


if(interaction.commandName === "ticket"){



const embed = new EmbedBuilder()

.setColor("#0099ff")

.setTitle("🎫 Centrum zgłoszeń — Los Santos Customs")

.setDescription(
`Witaj w systemie ticketów LSC.

Wybierz kategorię swojego zgłoszenia.

🔒 Ticket jest prywatny i widoczny dla Ciebie oraz zarządu.`
)

.addFields(

{
name:"👑 Zarząd",
value:"Sprawy do zarządu LSC."
},

{
name:"⚠️ Skarga",
value:"Zgłoszenie problemu."
},

{
name:"📈 Awans",
value:"Prośba o awans."
},

{
name:"👕 Strój",
value:"Podanie o własny strój."
},

{
name:"📋 Podanie",
value:"Dołączenie do LSC."
}

)

.setFooter({

text:"Los Santos Customs • Ticket System"

})

.setTimestamp();





const buttons = new ActionRowBuilder()

.addComponents(

new ButtonBuilder()
.setCustomId("zarzad")
.setLabel("👑 Zarząd")
.setStyle(ButtonStyle.Primary),


new ButtonBuilder()
.setCustomId("skarga")
.setLabel("⚠️ Skarga")
.setStyle(ButtonStyle.Danger),


new ButtonBuilder()
.setCustomId("awans")
.setLabel("📈 Awans")
.setStyle(ButtonStyle.Success),


new ButtonBuilder()
.setCustomId("stroj")
.setLabel("👕 Strój")
.setStyle(ButtonStyle.Secondary),


new ButtonBuilder()
.setCustomId("podanie")
.setLabel("📋 Podanie")
.setStyle(ButtonStyle.Primary)

);





await interaction.reply({

embeds:[embed],

components:[buttons]

});


}// ======================
// 📋 URLOP + OGŁOSZENIE
// ======================


if(interaction.commandName === "urlop"){



const modal = new ModalBuilder()

.setCustomId("urlop")

.setTitle("🌴 Urlop LSC");



const powod = new TextInputBuilder()

.setCustomId("powod")

.setLabel("Powód urlopu")

.setStyle(TextInputStyle.Paragraph);



modal.addComponents(

new ActionRowBuilder()

.addComponents(powod)

);



await interaction.showModal(modal);


}






if(interaction.commandName === "ogloszenie"){



const modal = new ModalBuilder()

.setCustomId("ogloszenie")

.setTitle("📢 Ogłoszenie LSC");



const tresc = new TextInputBuilder()

.setCustomId("tresc")

.setLabel("Treść ogłoszenia")

.setStyle(TextInputStyle.Paragraph);



modal.addComponents(

new ActionRowBuilder()

.addComponents(tresc)

);



await interaction.showModal(modal);


}


}









// ======================
// 📋 MODALE
// ======================


if(interaction.isModalSubmit()){





if(interaction.customId === "urlop"){



const embed = new EmbedBuilder()

.setColor("#00aaff")

.setTitle("🌴 Wniosek o urlop LSC")

.setDescription(

`📝 Powód urlopu:

${interaction.fields.getTextInputValue("powod")}`

)

.setFooter({

text:"Los Santos Customs • Urlopy"

})

.setTimestamp();



await interaction.reply({

embeds:[embed]

});


}







if(interaction.customId === "ogloszenie"){



const embed = new EmbedBuilder()

.setColor("#ffaa00")

.setTitle("📢 Oficjalne ogłoszenie LSC")

.setDescription(

interaction.fields.getTextInputValue("tresc")

)

.setFooter({

text:"Los Santos Customs • Zarząd"

})

.setTimestamp();



await interaction.reply({

content:"<@1525942164901597350>",

embeds:[embed]

});


}








// ======================
// 📋 PODANIE LSC
// ======================


if(interaction.customId === "podanie"){



const embed = new EmbedBuilder()

.setColor("#00ff88")

.setTitle("📋 Podanie do Los Santos Customs")

.addFields(

{
name:"👤 Wiek",
value:interaction.fields.getTextInputValue("wiek")
},

{
name:"🗣️ Mutacja",
value:interaction.fields.getTextInputValue("mutacja")
},

{
name:"🚗 Motoryzacja / mechanika",
value:interaction.fields.getTextInputValue("motoryzacja")
},

{
name:"⏰ Czas tygodniowo",
value:interaction.fields.getTextInputValue("godziny")
},

{
name:"⭐ Dlaczego Ty?",
value:interaction.fields.getTextInputValue("dlaczego")
},

{
name:"🙋 O sobie",
value:interaction.fields.getTextInputValue("osobie")
},

{
name:"🤝 Zaangażowanie",
value:interaction.fields.getTextInputValue("zaangazowanie")
},

{
name:"🔧 Wymiana zderzaka /me /do",
value:interaction.fields.getTextInputValue("zderzak")
},

{
name:"🛢️ Wymiana oleju /me /do",
value:interaction.fields.getTextInputValue("olej")
},

{
name:"📄 List motywacyjny",
value:interaction.fields.getTextInputValue("list")
}

)

.setFooter({

text:"LSC • Rekrutacja"

})

.setTimestamp();



await interaction.reply({

embeds:[embed]

});


}

}





// ======================
// 📋 OTWIERANIE PODANIA
// ======================


if(interaction.isButton()){



if(interaction.customId === "podanie"){



const modal = new ModalBuilder()

.setCustomId("podanie")

.setTitle("📋 Podanie do LSC");



const pola = [

["wiek","Wiek"],

["mutacja","Mutacja (Tak/Nie)"],

["motoryzacja","Motoryzacja / mechanika"],

["godziny","Ile godzin tygodniowo?"],

["dlaczego","Dlaczego Ciebie?"],

["osobie","Opowiedz o sobie"],

["zaangazowanie","Zaangażowanie"],

["zderzak","Wymiana zderzaka /me /do"],

["olej","Wymiana oleju /me /do"],

["list","List motywacyjny"]

];



for(const p of pola){



modal.addComponents(

new ActionRowBuilder()

.addComponents(

new TextInputBuilder()

.setCustomId(p[0])

.setLabel(p[1])

.setStyle(TextInputStyle.Paragraph)

)

);


}



await interaction.showModal(modal);

return;


}// ======================
// 🎫 TWORZENIE TICKETÓW
// ======================


const nazwy = {

zarzad:`👑・zarzad-${interaction.user.username}`,

skarga:`⚠️・skarga-${interaction.user.username}`,

awans:`📈・awans-${interaction.user.username}`,

stroj:`👕・stroj-${interaction.user.username}`,

podanie:`📋・podania-${interaction.user.username}`

};





const kategorie = {

zarzad:"1525942166244032640",

skarga:"1525942166244032641",

awans:"1525942166244032642",

stroj:"1525942166516404476",

podanie:"1525942166516404477"

};






if(interaction.isButton() && nazwy[interaction.customId]){



const kanal = await interaction.guild.channels.create({


name:nazwy[interaction.customId],


type:ChannelType.GuildText,


parent:kategorie[interaction.customId],



permissionOverwrites:[


{

id:interaction.guild.id,

deny:[

PermissionFlagsBits.ViewChannel

]

},



{

id:interaction.user.id,

allow:[

PermissionFlagsBits.ViewChannel,

PermissionFlagsBits.SendMessages

]

}


]



});







const embed = new EmbedBuilder()

.setColor("#0099ff")

.setTitle("🎫 Nowe zgłoszenie LSC")

.setDescription(
`Witaj w swoim tickecie Los Santos Customs!

👤 Autor:
${interaction.user}

📌 Kategoria:
${interaction.customId}

Zarząd LSC odpowie tutaj najszybciej jak to możliwe.`
)

.setFooter({

text:"Los Santos Customs • Ticket System"

})

.setTimestamp();







const przycisk = new ActionRowBuilder()

.addComponents(

new ButtonBuilder()

.setCustomId("zamknij")

.setLabel("🔒 Zamknij ticket")

.setStyle(ButtonStyle.Danger)

);







await kanal.send({

embeds:[embed],

components:[przyciski]

});






await interaction.reply({

content:`✅ Utworzono ticket: ${kanal}`,

ephemeral:true

});


}







// ======================
// 🔒 ZAMKNIĘCIE TICKETU
// ======================


if(interaction.customId === "zamknij"){



await interaction.reply({

content:"🔒 Ticket zostanie zamknięty za 5 sekund.",

ephemeral:true

});



setTimeout(()=>{

interaction.channel.delete();

},5000);



}



}

});






client.login(process.env.TOKEN);